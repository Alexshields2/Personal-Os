# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The anon key is designed to be public and ships in the client bundle. What
# protects your data is row-level security (see supabase/schema.sql), not the
# secrecy of this key. Never put the service_role key here.
#
# Leave both unset and the app runs local-only, with no sync.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
